{
  "name": "dpaternina/dp-core",
  "description": "dP Core — content model, dynamic blocks, REST and CLI for dpaternina.com.",
  "type": "wordpress-plugin",
  "version": "1.0.2",
  "license": "proprietary",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/fanxie-lab/wordpress-updater"
    }
  ],
  "require": {
    "php": "^8.4",
    "fanxielab/wp-update-client": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "DP\\Core\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.4.0"
    }
  }
}
