{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dp/meta-lines",
	"version": "0.1.0",
	"title": "Field: a list of lines",
	"category": "dp",
	"icon": "editor-ul",
	"description": "A field holding several short strings in order.",
	"textdomain": "dp-core",
	"attributes": {
		"metaKey": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"help": {
			"type": "string",
			"default": ""
		}
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"inserter": false,
		"html": false,
		"reusable": false,
		"multiple": true,
		"anchor": false,
		"align": false,
		"customClassName": false,
		"color": false,
		"spacing": false,
		"typography": false,
		"interactivity": false,
		"lock": false
	}
}
