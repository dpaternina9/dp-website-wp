{
  "name": "dp-site",
  "version": "0.1.0",
  "private": true,
  "description": "dpaternina.com — block theme + companion plugin monorepo.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.15.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "wp-scripts build --webpack-src-dir=plugins/dp-core/src/Blocks/js --output-path=plugins/dp-core/build",
    "start": "wp-scripts start --webpack-src-dir=plugins/dp-core/src/Blocks/js --output-path=plugins/dp-core/build",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:cli": "wp-env run cli wp",
    "env:seed": "wp-env run cli wp dp seed --fresh",
    "env:reset": "wp-env destroy && wp-env start && npm run env:seed",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "test:unit": "wp-scripts test-unit-js",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:ui": "playwright test --config=playwright.config.ts --ui"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.49.0",
    "@wordpress/e2e-test-utils-playwright": "^1.17.0",
    "@wordpress/env": "^10.16.0",
    "@wordpress/scripts": "^30.7.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  }
}
