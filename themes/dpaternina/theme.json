{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "background": {
      "backgroundImage": false,
      "backgroundSize": false
    },
    "border": {
      "color": false,
      "radius": false,
      "style": false,
      "width": false
    },
    "dimensions": {
      "minHeight": false
    },
    "shadow": {
      "defaultPresets": false,
      "presets": []
    },
    "lightbox": {
      "enabled": false,
      "allowEditing": false
    },
    "layout": {
      "contentSize": "880px",
      "wideSize": "1120px",
      "allowEditing": false
    },
    "color": {
      "background": true,
      "button": true,
      "caption": true,
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "heading": true,
      "link": true,
      "text": true,
      "palette": [
        { "slug": "dp-teal", "name": "dP Teal", "color": "#08d9d6" },
        { "slug": "dp-pink", "name": "dP Pink", "color": "#ff2e63" },
        { "slug": "dp-gold", "name": "dP Gold", "color": "#ffb84c" },
        { "slug": "dp-coral", "name": "dP Coral", "color": "#f4795e" },
        { "slug": "dp-purple", "name": "dP Purple", "color": "#6b479c" },
        { "slug": "dp-teal-600", "name": "dP Teal 600", "color": "#06b3b0" },
        { "slug": "dp-teal-100", "name": "dP Teal 100", "color": "#d6f7f6" },
        { "slug": "dp-pink-600", "name": "dP Pink 600", "color": "#e01450" },
        { "slug": "dp-pink-100", "name": "dP Pink 100", "color": "#ffdae4" },
        { "slug": "dp-gold-600", "name": "dP Gold 600", "color": "#f0a02e" },
        { "slug": "dp-gold-100", "name": "dP Gold 100", "color": "#fff0d6" },
        { "slug": "dp-coral-600", "name": "dP Coral 600", "color": "#e15c40" },
        { "slug": "dp-coral-100", "name": "dP Coral 100", "color": "#ffe3db" },
        { "slug": "dp-purple-600", "name": "dP Purple 600", "color": "#55367f" },
        { "slug": "dp-purple-100", "name": "dP Purple 100", "color": "#e7ddf3" },
        { "slug": "dp-black", "name": "dP Black", "color": "#000000" },
        { "slug": "dp-ink", "name": "dP Ink", "color": "#0c0c0e" },
        { "slug": "dp-graphite", "name": "dP Graphite", "color": "#17171b" },
        { "slug": "dp-slate", "name": "dP Slate", "color": "#2a2a31" },
        { "slug": "dp-gray", "name": "dP Gray", "color": "#9095a0" },
        { "slug": "dp-mist", "name": "dP Mist", "color": "#e8e8e8" },
        { "slug": "dp-cloud", "name": "dP Cloud", "color": "#f4f4f5" },
        { "slug": "dp-white", "name": "dP White", "color": "#ffffff" },
        { "slug": "bg-page", "name": "Page", "color": "#0c0c0e" },
        { "slug": "bg-surface", "name": "Surface", "color": "#17171b" },
        { "slug": "bg-raised", "name": "Raised", "color": "#1f1f25" },
        { "slug": "border-subtle", "name": "Border subtle", "color": "#2a2a31" },
        { "slug": "border-strong", "name": "Border strong", "color": "#3a3a44" },
        { "slug": "text-primary", "name": "Text primary", "color": "#ffffff" },
        { "slug": "text-secondary", "name": "Text secondary", "color": "#b4b4bd" },
        { "slug": "text-muted", "name": "Text muted", "color": "#9095a0" },
        { "slug": "text-inverse", "name": "Text inverse", "color": "#0c0c0e" },
        { "slug": "accent", "name": "Accent", "color": "#08d9d6" },
        { "slug": "accent-hover", "name": "Accent hover", "color": "#06b3b0" },
        { "slug": "accent-contrast", "name": "Accent contrast", "color": "#0c0c0e" },
        { "slug": "focus-ring", "name": "Focus ring", "color": "#08d9d6" },
        { "slug": "state-danger", "name": "Danger", "color": "#ff2e63" },
        { "slug": "state-warning", "name": "Warning", "color": "#ffb84c" },
        { "slug": "state-success", "name": "Success", "color": "#08d9d6" }
      ],
      "gradients": [
        {
          "slug": "dp-gradient-warm",
          "name": "Warm — pink to gold",
          "gradient": "linear-gradient(120deg, #ff2e63 0%, #f4795e 50%, #ffb84c 100%)"
        },
        {
          "slug": "dp-gradient-spectrum",
          "name": "Spectrum — pink to gold via purple and teal",
          "gradient": "linear-gradient(120deg, #ff2e63 0%, #6b479c 35%, #08d9d6 70%, #ffb84c 100%)"
        },
        {
          "slug": "dp-gradient-cool",
          "name": "Cool — teal to purple",
          "gradient": "linear-gradient(120deg, #08d9d6 0%, #6b479c 100%)"
        }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": false,
      "fontStyle": false,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textColumns": false,
      "textDecoration": true,
      "textTransform": true,
      "writingMode": false,
      "fontSizes": [
        { "slug": "fs-xs", "name": "XS — 12", "size": "0.75rem" },
        { "slug": "fs-sm", "name": "SM — 14", "size": "0.875rem" },
        { "slug": "fs-base", "name": "Base — 16", "size": "1rem" },
        { "slug": "fs-md", "name": "MD — 20", "size": "1.25rem" },
        { "slug": "fs-lg", "name": "LG — 24", "size": "1.5rem" },
        { "slug": "fs-xl", "name": "XL — 30", "size": "1.875rem" },
        { "slug": "fs-2-xl", "name": "2XL — 38", "size": "2.375rem" },
        { "slug": "fs-3-xl", "name": "3XL — 48", "size": "3rem" },
        { "slug": "fs-4-xl", "name": "4XL — 60", "size": "3.75rem" },
        { "slug": "fs-5-xl", "name": "5XL — 76", "size": "4.75rem" },
        { "slug": "fs-display", "name": "Display — fluid 38 to 76", "size": "clamp(2.375rem, 6vw, 4.75rem)" },
        { "slug": "fs-section", "name": "Section — fluid 30 to 38", "size": "clamp(1.875rem, 4vw, 2.375rem)" }
      ],
      "fontFamilies": [
        {
          "slug": "font-display",
          "name": "Display — Bricolage Grotesque",
          "fontFamily": "'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Bricolage Grotesque",
              "fontStyle": "normal",
              "fontWeight": "400 800",
              "fontDisplay": "swap",
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
              "src": [ "file:./assets/fonts/bricolage-grotesque/bricolage-grotesque-latin.woff2" ]
            },
            {
              "fontFamily": "Bricolage Grotesque",
              "fontStyle": "normal",
              "fontWeight": "400 800",
              "fontDisplay": "swap",
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF",
              "src": [ "file:./assets/fonts/bricolage-grotesque/bricolage-grotesque-latin-ext.woff2" ]
            }
          ]
        },
        {
          "slug": "font-body",
          "name": "Body — Manrope",
          "fontFamily": "'Manrope', ui-sans-serif, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Manrope",
              "fontStyle": "normal",
              "fontWeight": "400 800",
              "fontDisplay": "swap",
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
              "src": [ "file:./assets/fonts/manrope/manrope-latin.woff2" ]
            },
            {
              "fontFamily": "Manrope",
              "fontStyle": "normal",
              "fontWeight": "400 800",
              "fontDisplay": "swap",
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF",
              "src": [ "file:./assets/fonts/manrope/manrope-latin-ext.woff2" ]
            }
          ]
        },
        {
          "slug": "font-mono",
          "name": "Mono — JetBrains Mono",
          "fontFamily": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace",
          "fontFace": [
            {
              "fontFamily": "JetBrains Mono",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
              "src": [ "file:./assets/fonts/jetbrains-mono/jetbrains-mono-latin.woff2" ]
            },
            {
              "fontFamily": "JetBrains Mono",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF",
              "src": [ "file:./assets/fonts/jetbrains-mono/jetbrains-mono-latin-ext.woff2" ]
            }
          ]
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "margin": true,
      "padding": true,
      "units": [ "px", "rem", "ch", "vw", "vh", "%" ],
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "space-0", "name": "0", "size": "0" },
        { "slug": "space-1", "name": "1 — 4", "size": "0.25rem" },
        { "slug": "space-2", "name": "2 — 8", "size": "0.5rem" },
        { "slug": "space-3", "name": "3 — 12", "size": "0.75rem" },
        { "slug": "space-4", "name": "4 — 16", "size": "1rem" },
        { "slug": "space-5", "name": "5 — 24", "size": "1.5rem" },
        { "slug": "space-6", "name": "6 — 32", "size": "2rem" },
        { "slug": "space-7", "name": "7 — 48", "size": "3rem" },
        { "slug": "space-8", "name": "8 — 64", "size": "4rem" },
        { "slug": "space-9", "name": "9 — 96", "size": "6rem" },
        { "slug": "space-10", "name": "10 — 128", "size": "8rem" }
      ]
    },
    "custom": {
      "fw-regular": "400",
      "fw-medium": "500",
      "fw-semibold": "600",
      "fw-bold": "700",
      "fw-extrabold": "800",
      "lh-tight": "1.05",
      "lh-snug": "1.2",
      "lh-normal": "1.5",
      "lh-relaxed": "1.65",
      "ls-tight": "-0.02em",
      "ls-display": "-0.03em",
      "ls-normal": "0",
      "ls-wide": "0.04em",
      "ls-caps": "0.14em",
      "measure": "68ch",
      "tone-mix": "75%",
      "tone-toward": "#ffffff",
      "control-h-sm": "36px",
      "control-h-md": "44px",
      "control-h-lg": "52px",
      "control-px-sm": "0.75rem",
      "control-px-md": "1.5rem",
      "control-px-lg": "2rem",
      "control-gap-sm": "0.5rem",
      "control-gap-md": "0.5rem",
      "control-gap-lg": "0.75rem",
      "gutter": "clamp(1rem, 5vw, 2rem)",
      "section-y": "clamp(3rem, 8vw, 6rem)",
      "section-y-sm": "clamp(2rem, 6vw, 4rem)",
      "container-sm": "640px",
      "container-md": "880px",
      "container-lg": "1120px",
      "container-xl": "1320px",
      "target-min": "36px",
      "target-comfortable": "44px",
      "radius-xs": "4px",
      "radius-sm": "8px",
      "radius-md": "12px",
      "radius-lg": "16px",
      "radius-xl": "24px",
      "radius-pill": "999px",
      "radius-circle": "50%",
      "border-width": "1px",
      "border-width-strong": "2px",
      "shadow-sm": "0 1px 2px rgba(0,0,0,0.35)",
      "shadow-md": "0 8px 24px rgba(0,0,0,0.35)",
      "shadow-lg": "0 24px 60px rgba(0,0,0,0.45)",
      "shadow-glow-teal": "0 0 0 1px rgba(8,217,214,0.4), 0 8px 30px rgba(8,217,214,0.25)",
      "shadow-glow-pink": "0 0 0 1px rgba(255,46,99,0.4), 0 8px 30px rgba(255,46,99,0.25)",
      "ease-standard": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "ease-emphasis": "cubic-bezier(0.22, 1, 0.36, 1)",
      "dur-fast": "120ms",
      "dur-base": "200ms",
      "dur-slow": "380ms",
      "band": "#000000",
      "glow-soft": "12%",
      "glow-core": "34%",
      "glow-mid": "8%",
      "glow-ring": "30%",
      "accent-text": "#08d9d6",
      "hue-teal": "#08d9d6",
      "hue-gold": "#ffb84c",
      "hue-pink": "#ff2e63",
      "hue-purple": "#6b479c"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bg-page)",
      "text": "var(--wp--preset--color--text-primary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--font-body)",
      "fontSize": "var(--wp--preset--font-size--fs-base)",
      "fontWeight": "var(--wp--custom--fw-regular)",
      "lineHeight": "var(--wp--custom--lh-relaxed)",
      "letterSpacing": "var(--wp--custom--ls-normal)"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--space-5)",
      "padding": {
        "top": "0",
        "bottom": "0",
        "left": "var(--wp--custom--gutter)",
        "right": "var(--wp--custom--gutter)"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--font-display)",
          "fontWeight": "var(--wp--custom--fw-bold)",
          "lineHeight": "var(--wp--custom--lh-tight)",
          "letterSpacing": "var(--wp--custom--ls-display)"
        },
        "color": {
          "text": "var(--wp--preset--color--text-primary)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--fs-xl)",
          "lineHeight": "var(--wp--custom--lh-snug)",
          "letterSpacing": "var(--wp--custom--ls-display)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--fs-md)",
          "lineHeight": "var(--wp--custom--lh-snug)",
          "letterSpacing": "var(--wp--custom--ls-tight)"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--font-mono)",
          "fontSize": "var(--wp--preset--font-size--fs-xs)",
          "fontWeight": "var(--wp--custom--fw-medium)",
          "lineHeight": "var(--wp--custom--lh-relaxed)",
          "letterSpacing": "var(--wp--custom--ls-caps)",
          "textTransform": "uppercase"
        },
        "color": {
          "text": "var(--wp--custom--accent-text)"
        }
      },
      "caption": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--font-mono)",
          "fontSize": "var(--wp--preset--font-size--fs-xs)",
          "letterSpacing": "var(--wp--custom--ls-caps)"
        },
        "color": {
          "text": "var(--wp--preset--color--text-muted)"
        }
      },
      "link": {
        "color": { "text": "var(--wp--custom--accent-text)" },
        "typography": { "textDecoration": "underline" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--accent-hover)" }
        },
        ":focus": {
          "color": { "text": "var(--wp--preset--color--accent-hover)" }
        }
      }
    },
    "blocks": {
      "core/paragraph": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--fs-base)",
          "lineHeight": "var(--wp--custom--lh-relaxed)"
        },
        "color": {
          "text": "var(--wp--preset--color--text-secondary)"
        }
      },
      "core/list": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--fs-base)",
          "lineHeight": "var(--wp--custom--lh-relaxed)"
        },
        "color": {
          "text": "var(--wp--preset--color--text-secondary)"
        }
      },
      "core/quote": {
        "color": {
          "text": "var(--wp--preset--color--text-primary)"
        }
      },
      "core/code": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--font-mono)",
          "fontSize": "var(--wp--preset--font-size--fs-sm)",
          "lineHeight": "var(--wp--custom--lh-relaxed)"
        },
        "color": {
          "text": "var(--wp--custom--accent-text)"
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--fs-sm)",
          "lineHeight": "var(--wp--custom--lh-normal)"
        },
        "color": {
          "text": "var(--wp--preset--color--text-secondary)"
        }
      }
    }
  },
  "customTemplates": [
    { "name": "dp-work", "title": "Work — timeline", "postTypes": [ "page" ] },
    { "name": "dp-about", "title": "About", "postTypes": [ "page" ] },
    { "name": "dp-resume", "title": "Résumé", "postTypes": [ "page" ] },
    { "name": "dp-contact", "title": "Contact", "postTypes": [ "page" ] }
  ],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
