{
  "name": "dpaternina/dp-site",
  "description": "dpaternina.com — block theme + companion plugin monorepo.",
  "type": "project",
  "license": "proprietary",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/fanxie-lab/wordpress-updater"
    }
  ],
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "fanxielab/wp-update-client": "dev-main",
    "php-stubs/wordpress-tests-stubs": "^7.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^9.6",
    "roave/security-advisories": "dev-latest",
    "squizlabs/php_codesniffer": "^3.11",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "DP\\Core\\": "plugins/dp-core/src/",
      "DP\\Theme\\": "themes/dpaternina/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DP\\Tests\\Unit\\": "tests/Unit/",
      "DP\\Tests\\Integration\\": "tests/Integration/",
      "DP\\Tests\\Support\\": "tests/Support/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "process-timeout": 900,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@install-core-vendor",
      "@dump-theme-autoload"
    ],
    "post-update-cmd": [
      "@install-core-vendor",
      "@dump-theme-autoload"
    ],
    "install-core-vendor": "@composer install --working-dir=plugins/dp-core --no-interaction --no-progress",
    "dump-theme-autoload": "@composer dump-autoload --working-dir=themes/dpaternina --optimize --no-interaction",
    "tokens:build": "php bin/dp-tokens.php",
    "tokens:check": "php bin/dp-tokens.php --check",
        "design:baseline": "php bin/dp-design-baseline.php",
        "design:check": "php bin/dp-design-baseline.php --check",
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=2G",
    "test": [
      "@test:unit",
      "@test:integration"
    ],
    "test:unit": "phpunit --testsuite Unit",
    "test:integration": "npx wp-env run tests-cli --env-cwd=wp-content/dp-repo vendor/bin/phpunit --testsuite Integration"
  },
  "scripts-descriptions": {
    "lint": "PHPCS: WordPress-Coding-Standards + PHPCompatibilityWP (PHP 8.4).",
    "analyse": "PHPStan level 9 with szepeviktor/phpstan-wordpress.",
    "test": "PHPUnit: Unit on the host, Integration inside the wp-env tests container.",
    "install-core-vendor": "Install plugins/dp-core/vendor (autoloader + the wp-update-client library) so the mounted plugin can boot.",
    "dump-theme-autoload": "Regenerate themes/dpaternina/vendor/autoload.php so the mounted theme can boot.",
    "tokens:build": "Regenerate the theme's token bridge from design-source/.",
    "tokens:check": "Fail if the committed token bridge is not what design-source/ implies."
  }
}
