# EditorConfig — https://editorconfig.org
# Matches the WordPress Coding Standards defaults: tabs for code, spaces for data.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.{md,markdown}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{json,jsonc,yml,yaml,neon,dist,xml,xml.dist}]
indent_style = space
indent_size = 2

[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_style = tab
indent_size = 4

[*.{css,scss}]
indent_style = tab
indent_size = 4

[{package.json,composer.json,.editorconfig}]
indent_style = space
indent_size = 2

[LICENSE]
indent_style = space
