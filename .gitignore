# --- Dependencies -----------------------------------------------------------
/node_modules/
**/node_modules/
/vendor/
**/vendor/

# --- Build output -----------------------------------------------------------
/build/
**/build/
/dist/
**/dist/
*.zip

# --- Local environment ------------------------------------------------------
# .wp-env.json is committed; the per-developer override never is.
.wp-env.override.json
/wp-env/

# --- Tooling caches ---------------------------------------------------------
.phpunit.result.cache
.phpunit.cache/
.phpcs-cache
/.php-cs-fixer.cache
.phpstan.cache/
/.cache/
**/.cache/
.eslintcache
.stylelintcache
/.husky/_/

# --- Test artefacts ---------------------------------------------------------
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
/coverage/
/artifacts/

# --- Generated content ------------------------------------------------------
# Résumé PDFs and any other renderer output are cached artefacts, never sources.
/generated/
**/generated/
*.pdf
# ...but design-source/ is the contract. Nothing in it is ever dropped silently.
!design-source/**

# --- Logs and OS cruft ------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# --- Deliberately NOT ignored -----------------------------------------------
# composer.lock and package-lock.json ARE committed. Pinning the toolchain is
# the point of Phase 0: CI, David's machine, and the release workflow must all
# resolve byte-identical dependency trees.
#
# plugins/dp-core/vendor/ and themes/dpaternina/vendor/ are NOT committed. Each
# holds only a generated Composer autoloader; `composer install` at the root
# regenerates both, and the release workflow regenerates them again when it
# builds the zips. See docs/adr/0001 §1 and docs/adr/0002.
#
# themes/dpaternina/assets/css/tokens.css IS committed even though it is
# generated. It is a build artefact the theme cannot boot without, and the
# release zip must not need design-source/ to exist. `composer tokens:check`
# and the token-parity test both fail if it is stale. See docs/adr/0002.
#
# themes/dpaternina/assets/fonts/*.woff2 ARE committed. They are the theme's
# only binary dependency, they are OFL-licensed with the licence beside them,
# and re-downloading them at build time would put a Google request back into
# the pipeline we just took it out of.

# Agent worktrees created by the harness inside the repo.
.claude/
